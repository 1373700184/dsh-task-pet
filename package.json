{
  "name": "dsh-task-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop pet outside the browser that shows dsh task progress",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/DshPet.exe",
    "src/pet.cpp",
    "build.ps1"
  ],
  "scripts": {
    "build:pet": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
